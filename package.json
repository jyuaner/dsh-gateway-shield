{
  "name": "dsh-gateway-shield",
  "version": "0.6.0",
  "description": "DSH 出网前的提示词栅栏：按 provider 分档的指纹同义改写（system / messages / tools / toolHistory 四个面）+ 软拒绝带加固重试。provider 无关，装一次对全模型生效，不依赖任何连接器或破甲插件。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-gateway-shield": "install.mjs",
    "dsh-armor": "armor/armor.mjs"
  },
  "files": [
    "lib",
    "armor",
    "scripts",
    "docs",
    "cordis.patch.yml",
    "install.mjs",
    "bootstrap.mjs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.1"
  },
  "scripts": {
    "test": "node scripts/selftest.mjs && node scripts/e2e.mjs && node scripts/companions-test.mjs && node scripts/provider-coverage-test.mjs && node armor/armor-test.mjs",
    "selftest": "node scripts/selftest.mjs",
    "e2e": "node scripts/e2e.mjs",
    "test:companions": "node scripts/companions-test.mjs",
    "test:providers": "node scripts/provider-coverage-test.mjs",
    "test:armor": "node armor/armor-test.mjs",
    "armor": "node armor/armor.mjs",
    "armor:check": "node armor/armor.mjs --check",
    "probe": "node scripts/probe-waterfall.mjs && node scripts/probe-reentry.mjs",
    "verify": "node install.mjs --verify",
    "setup": "node install.mjs",
    "setup:all": "node install.mjs --with-companions"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "provider-agnostic",
    "any-provider",
    "gateway",
    "fingerprint",
    "prompt",
    "workbuddy",
    "qoder",
    "trae",
    "llm",
    "cordis"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jyuaner/dsh-gateway-shield.git"
  },
  "homepage": "https://github.com/jyuaner/dsh-gateway-shield#readme",
  "bugs": {
    "url": "https://github.com/jyuaner/dsh-gateway-shield/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dsh": ">=0.2.1-rc.1 <0.3.0",
      "profiles": [
        "web",
        "desktop"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  }
}
